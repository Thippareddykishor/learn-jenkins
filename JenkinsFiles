pipeline  {
agent any
environment {
    DEPLOY ='DEV'
}
parameters{
    string(name: 'Person',defaultValue:'Mr. Reddy' )
    string(name: 'env',    defaultValue: 'dev')
}
stages{
    stage('checkout'){
        steps {
            sh '''
     echo "Person: ${Person}"
            '''
        }
    }
    stage('deploy'){
        when {
                environment name: 'DEPLOY' , value: 'dev'
            }
        steps {
            sh '''
            echo 'deploy to
            '''
        }
    }
}
post {
    always{
        cleanWs()
    }
}
}